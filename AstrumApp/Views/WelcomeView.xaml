<UserControl x:Class="AstrumApp.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <!-- Две простые кнопки. Логику переходов не размещаем в стилях. -->
        <Style x:Key="WelcomePrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="154"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Background" Value="#377FC9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4699E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2565A4"/>
                            </Trigger>
                            <!--<Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            </Trigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WelcomeSecondaryButton" TargetType="Button"
               BasedOn="{StaticResource WelcomePrimaryButton}">
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="Background" Value="#152536"/>
            <Setter Property="Foreground" Value="#D1E2F2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#38536C"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#20364C"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6794BB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#102031"/>
                            </Trigger>
                            <!--<Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            </Trigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="WelcomeRoot" ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1015" Offset="0"/>
                <GradientStop Color="#111E2B" Offset="0.56"/>
                <GradientStop Color="#0C141D" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Фоновая засветка: декоративный слой без тяжёлого BlurEffect. -->
        <Ellipse Width="610" Height="610"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,-230,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#38456F97" Offset="0"/>
                    <GradientStop Color="#142D577A" Offset="0.6"/>
                    <GradientStop Color="#002D577A" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="42,24,42,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- Верхний брендовый блок -->
            <StackPanel x:Name="BrandHeader" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="BrandHeaderShift"/>
                </StackPanel.RenderTransform>
                <Border Width="32" Height="32" CornerRadius="10" Background="#1B3249"
                        BorderBrush="#345D81" BorderThickness="1">
                    <Path x:Name="HeaderLogoPath" Width="19" Height="19" Opacity="0" Stretch="Fill" Fill="#B4DAFF"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 50,0 L 61,37 L 100,50 L 61,62 L 50,100 L 39,62 L 0,50 L 39,37 Z"/>
                </Border>
                <TextBlock Text="ASTRUM" FontSize="16" FontWeight="Bold"
                           Foreground="#E8F1FA" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="FirstLaunchLabel" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0"
                       Text="ПЕРВЫЙ ЗАПУСК" FontSize="11" FontWeight="SemiBold"
                       Foreground="#7C96AC"/>

            <!-- Основная композиция: смысловая часть слева, декоративный знак справа. -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.28*"/>
                    <ColumnDefinition Width="0.72*"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="WelcomeContent" Grid.Column="0" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                            MaxWidth="490">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Height="2" Width="22" Background="#71B5EF"
                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="ТВОЁ ПРОСТРАНСТВО" Foreground="#8FBEE4"
                                   FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>

                    <TextBlock FontSize="35" LineHeight="43" FontWeight="SemiBold"
                               Foreground="#F3F7FC" TextWrapping="Wrap">
                        <Run Text="Добро пожаловать"/>
                        <LineBreak/>
                        <Run Text="в "/><Run Text="Astrum" Foreground="#A6D5FF"/>
                    </TextBlock>

                    <TextBlock Margin="0,16,22,0" FontSize="15" LineHeight="24"
                               Foreground="#A2B6C8" TextWrapping="Wrap"
                               Text="О, кажется, ты здесь впервые! Давай познакомимся и настроим всё под тебя. Готов к новым открытиям с Astrum?"/>

                    <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                        <Button x:Name="StartButton" Content="Начать"
                                Style="{StaticResource WelcomePrimaryButton}"
                                Click="StartButton_Click"/>
                        <Button x:Name="SignInButton" Content="У меня уже есть аккаунт"
                                Style="{StaticResource WelcomeSecondaryButton}"
                                Margin="12,0,0,0" Click="SignInButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Графика не перехватывает ввод и не участвует в навигации. -->
                <Viewbox x:Name="DecorationHost" Grid.Column="1" Opacity="0" Stretch="Uniform" MaxWidth="350" MaxHeight="350"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsHitTestVisible="False">
                    <Grid Width="350" Height="350">
                        <!-- Ореол -->
                        <Ellipse Width="286" Height="286" HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#4268B6F4" Offset="0"/>
                                    <GradientStop Color="#213C8EC5" Offset="0.48"/>
                                    <GradientStop Color="#003C8EC5" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Орбитальные линии -->
                        <Ellipse Width="280" Height="280" Stroke="#38516B"
                                 StrokeThickness="1" Opacity="0.6"/>
                        <Ellipse Width="310" Height="154" Stroke="#5B8EB7"
                                 StrokeThickness="1.4" Opacity="0.65"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-30" CenterX="155" CenterY="77"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="285" Height="130" Stroke="#466B8E"
                                 StrokeThickness="1" Opacity="0.45"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="49" CenterX="142.5" CenterY="65"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Маленькая точка на орбите -->
                        <Ellipse Width="9" Height="9" Fill="#96D4FF"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="33,236,0,0"/>

                        <!-- Временная эмблема; заменим на окончательный логотип позже. -->
                        <Grid Width="136" Height="136" HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Ellipse Width="136" Height="136">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#618BC6F1" Offset="0"/>
                                        <GradientStop Color="#204D93CA" Offset="0.56"/>
                                        <GradientStop Color="#004D93CA" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Path Width="78" Height="78" Stretch="Fill"
                                  Fill="#DBEEFF" HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 50,0 L 61,37 L 100,50 L 61,62 L 50,100 L 39,62 L 0,50 L 39,37 Z"/>
                        </Grid>
                    </Grid>
                </Viewbox>
            </Grid>

            <!-- Ненавязчивая подпись -->
            <TextBlock x:Name="WelcomeFooter" Grid.Row="2" Opacity="0" VerticalAlignment="Bottom"
                       Text="Настроить внешний вид и анимации можно позже в персонализации"
                       FontSize="11" Foreground="#748A9E"/>
        </Grid>

        <!--
            Отдельная звезда поверх WelcomeView.
            На первом кадре она точно в центре экрана, после чего прилетает
            в логотип слева сверху. Координаты вычисляются в code-behind,
            поэтому анимация не зависит от ширины окна.
        -->
        <Grid x:Name="StarAnimationLayer" Panel.ZIndex="10" IsHitTestVisible="False">
            <Grid x:Name="FlyingStar" Width="108" Height="108"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="FlyingStarScale" ScaleX="1.35" ScaleY="1.35"/>
                        <RotateTransform x:Name="FlyingStarRotation" Angle="-12"/>
                        <TranslateTransform x:Name="FlyingStarShift"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <Ellipse Width="108" Height="108">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#70B0DFFF" Offset="0"/>
                            <GradientStop Color="#305DADFA" Offset="0.45"/>
                            <GradientStop Color="#005DADFA" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    </Ellipse>
                <Path Width="74" Height="74" Stretch="Fill" Fill="#DBEEFF"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 50,0 L 61,37 L 100,50 L 61,62 L 50,100 L 39,62 L 0,50 L 39,37 Z"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
