<Window x:Class="AstrumApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstrumApp"
        xmlns:controls="clr-namespace:AstrumApp.Controls"
        xmlns:services="clr-namespace:AstrumApp.Services"
        xmlns:settings="clr-namespace:AstrumApp.Apps.Settings"
        mc:Ignorable="d"
        Title="MainWindow" Height="648" Width="1152" Unloaded="UnLoad" ResizeMode="NoResize"
        PreviewMouseDown="MainWindow_PreviewMouseDown"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <Grid>
        <controls:Desktop x:Name="DesktopControl" Visibility="Visible"/>
        <controls:LeftPanel x:Name="LeftPanelControl" Visibility="Visible"/>
        <controls:RightPanel x:Name="RightPanelControl" Visibility="Visible" HorizontalAlignment="Right" VerticalAlignment="Top">
            <controls:RightPanel.RenderTransform>
                <TranslateTransform X="300" Y="20"/>
            </controls:RightPanel.RenderTransform>
        </controls:RightPanel>
        <controls:LockScreen x:Name="LockScreenControl" Visibility="Visible">
            <controls:LockScreen.RenderTransform>
                <TranslateTransform X="0" Y="0"/>
            </controls:LockScreen.RenderTransform>
        </controls:LockScreen>

        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>

        <controls:NotificationControl HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                      Margin="0, 0, 0, 50"/>

        <Rectangle x:Name="BlackoutMask" Fill="Black" Opacity="0.5" Visibility="Hidden"/>   
    </Grid>
</Window>
