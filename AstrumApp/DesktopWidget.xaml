<Window x:Class="AstrumApp.DesktopWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Width="270"
        Height="340"

        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#00FFFFFF"

        Topmost="False"
        ShowInTaskbar="False">

    <Grid>

        <Border x:Name="WidgetCard"
                Margin="12"
                CornerRadius="50"
                RenderTransformOrigin="0.5,0.5"
                ClipToBounds="True">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#704488F2" Offset="0"/>
                    <GradientStop Color="#7080D3ED" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect Color="#2F80FF"
                                  BlurRadius="10"
                                  ShadowDepth="0"
                                  Opacity="0.7"/>
            </Border.Effect>

            <Border.Style>
                <Style TargetType="Border">

                    <Style.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">

                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="RenderTransform.ScaleX"
                                            To="1.05"
                                            Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="RenderTransform.ScaleY"
                                            To="1.05"
                                            Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.Effect).BlurRadius"
                                            To="13"
                                            Duration="0:0:0.22"/>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.Effect).Opacity"
                                            To="1"
                                            Duration="0:0:0.22"/>

                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="RenderTransform.ScaleX"
                                            To="1"
                                            Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="RenderTransform.ScaleY"
                                            To="1"
                                            Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.Effect).BlurRadius"
                                            To="10"
                                            Duration="0:0:0.22"/>

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.Effect).Opacity"
                                            To="0.7"
                                            Duration="0:0:0.22"/>

                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>

                        </Trigger>

                    </Style.Triggers>

                </Style>
            </Border.Style>

            <Grid>
                <StackPanel>
                    <TextBlock Text="Погода" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock x:Name="WeatherDesc" Text="" FontSize="16" FontWeight="Bold"  Foreground="White" TextAlignment="Center"
                                    TextWrapping="Wrap" MaxWidth="200"/>

                        <TextBlock x:Name="WeatherCity" Text="г." FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

                    </StackPanel>
                    <TextBlock x:Name="WeatherTemp" Text="• Температура: " FontSize="14" Margin="20 15 0 0" FontWeight="Bold" Foreground="#F2F2F2"/>
                    <TextBlock x:Name="WeatherFeels" Text="• Ощущается как " FontSize="14" Margin="20 15 0 0" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="WeatherHumidity" Text="• Влажность: " FontSize="14" Margin="20 15 0 0" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="WeatherWind" Text="• Скорость ветра: " FontSize="14" Margin="20 15 0 0" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Grid>

        </Border>

    </Grid>
</Window>