<UserControl x:Class="AstrumApp.Controls.LeftPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstrumApp"
             mc:Ignorable="d" 
             d:DesignHeight="585" d:DesignWidth="1040">

    <UserControl.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#2F80FF" BlurRadius="7" ShadowDepth="0" Opacity="0.8"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[0].Color"
                                                To="#00C6FF" Duration="0:0:1"/>

                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[1].Color"
                                                To="#2F80FF" Duration="0:0:1"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>


                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>

                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[0].Color"
                                                To="#2F80FF" Duration="0:0:1"/>
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[1].Color"
                                                To="#00C6FF" Duration="0:0:1"/>

                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.15"/>

                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid HorizontalAlignment="Left">
        <Grid x:Name="LeftPannelTrigger" Background="Transparent" Width="200" Height="550" HorizontalAlignment="Left" VerticalAlignment="Center" 
              MouseEnter="Trigger_MouseEnter" MouseLeave="Trigger_MouseLeave"/>
        <Border x:Name="LeftPanelContent" Width="500" VerticalAlignment="Stretch" CornerRadius="50" Opacity="0.8" MouseEnter="LeftPanel_MouseEnter" 
                MouseLeave="LeftPanel_MouseLeave">
            <Border.Background>
                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                    <GradientStop Color="#7FB2FF" Offset="0"/>
                    <GradientStop Color="#D6F4FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#2F80FF" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform X="-500" Y="0" x:Name="LeftPanelContent_Transform"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Width="350" CornerRadius="25" MouseLeftButtonDown="Border_MouseLeftButtonDown" RenderTransformOrigin="0.5,0.5" 
                        MouseLeftButtonUp="Border_MouseLeftButtonUp" Cursor="Hand" Grid.Row="1">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource NavButtonStyle}">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush>
                                        <GradientStop Color="#2F80FF" Offset="0"/>
                                        <GradientStop Color="#00C6FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBlock Text="Настройки" FontSize="30" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Left" Margin="20,30,0,30"/>
                        <Image Source="/Assets/icons/Navigator/setting-lines.png" Width="90" Height="90" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    </Grid>
                </Border>

                <Border Width="350" CornerRadius="25" MouseLeftButtonDown="Border_MouseLeftButtonDown" RenderTransformOrigin="0.5,0.5" 
                        MouseLeftButtonUp="Border_MouseLeftButtonUp" Cursor="Hand" Grid.Row="3">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource NavButtonStyle}">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush>
                                        <GradientStop Color="#2F80FF" Offset="0"/>
                                        <GradientStop Color="#00C6FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBlock Text="Приложения" FontSize="30" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Left" Margin="20,30,0,30"/>
                        <Image Source="/Assets/icons/Navigator/apps.png" Width="90" Height="90" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    </Grid>
                </Border>

                <Border Width="350" CornerRadius="25" MouseLeftButtonDown="Border_MouseLeftButtonDown" RenderTransformOrigin="0.5,0.5" 
                        MouseLeftButtonUp="Border_MouseLeftButtonUp" Cursor="Hand" Grid.Row="5">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource NavButtonStyle}">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush>
                                        <GradientStop Color="#2F80FF" Offset="0"/>
                                        <GradientStop Color="#00C6FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBlock Text="Игры" FontSize="30" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Left" Margin="20,30,0,30"/>
                        <Image Source="/Assets/icons/Navigator/games.png" Width="90" Height="90" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
