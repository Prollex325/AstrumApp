<UserControl x:Class="AstrumApp.Controls.ProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:AstrumApp.Controls"
    mc:Ignorable="d" 
    xmlns:controls="clr-namespace:AstrumApp.Controls"
    Width="530" Height="465"
    d:DesignHeight="465" d:DesignWidth="530">

    <UserControl.Resources>
        <!-- Одна локальная кнопка: глобальные стили AstrumApp не затрагиваем. -->
        <Style x:Key="ProgressActionButton" TargetType="Button">
            <Setter Property="Background" Value="#377FDF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12" BorderThickness="1"
                                BorderBrush="#587DB8EE">
                            <Grid>
                                <Border CornerRadius="12" Margin="1"
                                        VerticalAlignment="Top" Height="20"
                                        Opacity="0.13">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#468EF5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2863B1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Прозрачный запас по краям, чтобы не обрезать внешнюю тень -->
    <Grid x:Name="WindowBody" Margin="18" Opacity="0"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="AppearScale" ScaleX="0.96" ScaleY="0.96"/>
        </Grid.RenderTransform>

        <!-- Отдельный визуальный слой: тень применяется только к фону, а не к контенту. -->
        <Border CornerRadius="25" BorderThickness="1" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#182431" Offset="0"/>
                    <GradientStop Color="#111A24" Offset="0.56"/>
                    <GradientStop Color="#0E151D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#52647E" Offset="0"/>
                    <GradientStop Color="#293848" Offset="0.5"/>
                    <GradientStop Color="#15212C" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="29"
                                  ShadowDepth="11" Opacity="0.65"/>
            </Border.Effect>
        </Border>

        <!-- Содержимое поверх фона. Margin=1 компенсирует прежний BorderThickness=1. -->
        <Grid Margin="1" ClipToBounds="True">
                <!-- Деликатные световые пятна на фоне -->
                <!--<Ellipse Width="280" Height="280" Fill="#153E83CB"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-155,-195,0,0" IsHitTestVisible="False">
                    <Ellipse.Effect>
                        <BlurEffect Radius="65"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="200" Height="200" Fill="#0D4A7EC6"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-130,-145" IsHitTestVisible="False">
                    <Ellipse.Effect>
                        <BlurEffect Radius="65"/>
                    </Ellipse.Effect>
                </Ellipse>-->

                <Grid Margin="36,25,36,27">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="13"/>
                    <RowDefinition Height="178"/>
                    <RowDefinition Height="11"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="48"/>
                </Grid.RowDefinitions>

                <!-- Шапка -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#6AAFFF"
                                 Margin="0,0,10,0"/>
                        <TextBlock Text="ASTRUMAPP" FontFamily="Segoe UI"
                                   FontWeight="Bold" FontSize="12"
                                   Foreground="#DDEAFF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="НАСТРОЙКА ПРОФИЛЯ"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="10" Foreground="#69849D"/>
                </Grid>

                <!-- Анимированная загрузка -->
                <Grid x:Name="LoadingVisual" Grid.Row="2" Width="176"
                      Height="176" HorizontalAlignment="Center">
                    <Ellipse x:Name="LoadingHalo" Width="169" Height="169"
                             Fill="#244887D0" Opacity="0.40">
                        <Ellipse.Effect>
                            <BlurEffect Radius="33"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <Ellipse Width="156" Height="156" Stroke="#27425D"
                             StrokeThickness="1"/>

                    <!-- Внешняя вращающаяся дуга и светящаяся точка -->
                    <Grid Width="156" Height="156" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="OuterRotation"/>
                        </Grid.RenderTransform>
                        <Ellipse Stroke="#8CB9FF" StrokeThickness="2.8"
                                 StrokeDashArray="18 78"
                                 StrokeStartLineCap="Round"
                                 StrokeEndLineCap="Round"/>
                        <Ellipse Width="8" Height="8" Fill="#C2E4FF"
                                 VerticalAlignment="Top" Margin="0,-3,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#6AACFF" BlurRadius="14"
                                                  ShadowDepth="0" Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                    <!-- Вторая дуга вращается в обратную сторону -->
                    <Grid Width="126" Height="126" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="InnerRotation"/>
                        </Grid.RenderTransform>
                        <Ellipse Stroke="#4C739E" StrokeThickness="1.9"
                                 StrokeDashArray="10 17"/>
                    </Grid>

                    <Ellipse Width="102" Height="102" Fill="#132333"
                             Stroke="#31506D" StrokeThickness="1"/>
                    <Border Width="76" Height="76" CornerRadius="38"
                            BorderThickness="1" BorderBrush="#406793"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#294869" Offset="0"/>
                                <GradientStop Color="#172D42" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="✦" Foreground="#B5D8FF" FontSize="39"
                                   FontFamily="Segoe UI Symbol"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Итог: успех или ошибка (изначально скрыт) -->
                <Grid x:Name="ResultVisual" Grid.Row="2" Width="176" Height="176"
                      Visibility="Collapsed" HorizontalAlignment="Center">
                    <Ellipse x:Name="ResultHalo" Width="170" Height="170"
                             Fill="#2666CBAD" Opacity="0.45">
                        <Ellipse.Effect>
                            <BlurEffect Radius="35"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="151" Height="151" Stroke="#3C58756B"
                             StrokeThickness="1.5"/>
                    <Border x:Name="ResultCircle" Width="110" Height="110"
                            Background="#204B45" BorderBrush="#4EAC96"
                            BorderThickness="1.5" CornerRadius="55"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ResultScale" ScaleX="0.75" ScaleY="0.75"/>
                        </Border.RenderTransform>
                        <Path x:Name="ResultIcon"
                              Data="M 7,26 L 21,40 L 50,9"
                              Stroke="#A2F1D5" StrokeThickness="5.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Stretch="Uniform"
                              Width="54" Height="54"/>
                    </Border>
                </Grid>

                <!-- Заголовок и описание -->
                <StackPanel Grid.Row="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Создаём ваш аккаунт"
                               Foreground="#F1F6FF" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="MessageText"
                               Text="Подготавливаем профиль и сохраняем настройки."
                               Foreground="#94AABD" FontSize="13" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="370" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Статус: показываем только во время загрузки -->
                <Border x:Name="LoadingStatus" Grid.Row="5"
                        Padding="13,7" CornerRadius="12"
                        Background="#1B2E40" BorderBrush="#2E4660" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                 Fill="#70B1FF" VerticalAlignment="Center"
                                 Margin="0,0,9,0"/>
                        <TextBlock x:Name="StatusText" Text="Подключаемся к Supabase..."
                                   FontSize="12" Foreground="#BCD5ED"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Появляется только по завершении -->
                <Button x:Name="ContinueButton" Grid.Row="6"
                        Width="205" Height="46" Visibility="Collapsed"
                        Opacity="0" HorizontalAlignment="Center"
                        Content="Продолжить  →"
                        Style="{StaticResource ProgressActionButton}"
                        Click="ContinueButton_Click"/>
                <TextBlock x:Name="WaitingNote" Grid.Row="6"
                           Text="Пожалуйста, не закрывайте приложение"
                           FontSize="11" Foreground="#637B90"
                           TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
