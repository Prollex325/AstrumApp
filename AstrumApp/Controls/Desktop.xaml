<UserControl x:Class="AstrumApp.Controls.Desktop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstrumApp"
             mc:Ignorable="d" 
             d:DesignHeight="585" d:DesignWidth="1040">

    <Grid>
        <Image Source="/Assets/wallpapers/desktop.png" Stretch="Fill" Margin="0,0,0,0"/>

        <TextBlock x:Name="Clock" Text="HH:MM" FontSize="48" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 80 0 0" Visibility="Visible"/>
        <TextBlock x:Name="Date" Text="xx, day, xxxx" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 150 0 0" Visibility="Visible"/>
    </Grid>
</UserControl>
