<UserControl x:Class="AstrumApp.Controls.NewsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AstrumApp.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="TextButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="#4873A7" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Padding"
                    Value="0,3" />
            <Setter Property="HorizontalAlignment"
                    Value="Left" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">

                            <TextBlock x:Name="ButtonText"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonText"
                                        Property="Foreground"
                                        Value="#24558E" />

                                <Setter TargetName="ButtonText"
                                        Property="TextDecorations"
                                        Value="Underline" />
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonText"
                                        Property="Foreground"
                                        Value="#183A62" />
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonText"
                                        Property="Foreground"
                                        Value="#9CAABA" />
                                <Setter Property="Cursor"
                                        Value="Arrow" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Width="450"
          HorizontalAlignment="Right"
          VerticalAlignment="Stretch"
          Margin="0,12,12,12">

        <Grid x:Name="Trigger"
              Background="Transparent"
              Width="100"
              Height="550"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              MouseEnter="Trigger_MouseEnter"
              MouseLeave="Trigger_MouseLeave" />

        <Border x:Name="NewsPanel"
                Width="450"
                CornerRadius="33"
                BorderThickness="1.5"
                Padding="16"
                MouseEnter="NewsControl_MouseEnter"
                MouseLeave="NewsControl_MouseLeave">

            <Border.RenderTransform>
                <TranslateTransform X="470" />
            </Border.RenderTransform>

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Color="#D6FFFFFF"
                                  Offset="0" />
                    <GradientStop Color="#87FFFFFF"
                                  Offset="0.5" />
                    <GradientStop Color="#C9FFFFFF"
                                  Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Color="#FFFFFFFF"
                                  Offset="0" />
                    <GradientStop Color="#87FFFFFF"
                                  Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Заголовок панели  -->
                <Border Grid.Row="0"
                        CornerRadius="20"
                        Background="#80FFFFFF"
                        BorderBrush="#CCFFFFFF"
                        BorderThickness="1"
                        Padding="18,14"
                        Margin="0,0,0,14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Что нового?"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#293E58" />

                            <TextBlock Text="Новости и события Astrum"
                                       FontSize="14"
                                       Foreground="#687F99"
                                       Margin="0,3,0,0" />

                        </StackPanel>

                        <!--  Кнопка обновления новостей  -->
                        <Button x:Name="RefreshNewsButton"
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Cursor="Hand"
                                Background="#60FFFFFF"
                                BorderThickness="1"
                                BorderBrush="#CCFFFFFF"
                                Click="UpdateNews">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="12">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />

                                    </Border>
                                </ControlTemplate>
                            </Button.Template>


                            <Path Data="M20,4 V10 H14 M20,10 A8,8 0 1 0 20,16"
                                  Stroke="#536F8F"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="19"
                                  Height="19" />

                        </Button>

                        <Border x:Name="NewsLoadingIndicator"
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                CornerRadius="12"
                                Background="#60FFFFFF"
                                BorderBrush="#CCFFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                Visibility="Visible">

                            <Grid Width="22"
                                  Height="22">

                                <!--  Неподвижное кольцо  -->
                                <Ellipse Stroke="#26536F8F"
                                         StrokeThickness="2.5" />

                                <!--  Вращающаяся дуга  -->
                                <Path Data="M11,1.25 A9.75,9.75 0 0 1 20.75,11"
                                      Stroke="#536F8F"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5">

                                    <Path.RenderTransform>
                                        <RotateTransform />
                                    </Path.RenderTransform>

                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <Trigger Property="IsVisible"
                                                         Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard x:Name="SpinAnimation">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0"
                                                                                 To="360"
                                                                                 Duration="0:0:0.85"
                                                                                 RepeatBehavior="Forever" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>

                                                    <Trigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="SpinAnimation" />
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>

                                </Path>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!--  Будущая лента новостей  -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource GlassScrollBarStyle}" />
                    </ScrollViewer.Resources>

                    <ScrollViewer.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="0,1">

                            <GradientStop Color="Transparent"
                                          Offset="0" />
                            <GradientStop Color="White"
                                          Offset="0.025" />

                            <GradientStop Color="White"
                                          Offset="0.975" />
                            <GradientStop Color="Transparent"
                                          Offset="1" />

                        </LinearGradientBrush>
                    </ScrollViewer.OpacityMask>
                    <Grid>

                        <StackPanel x:Name="EmptyNewsState"
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Visible">

                            <Path Data="M4,3 H20 V21 H4 Z M7,6 H17 V10 H7 Z M7,13 H11 M13,13 H17 M7,16 H11 M13,16 H17"
                                  Width="52"
                                  Height="52"
                                  Stretch="Uniform"
                                  Stroke="#829DBB"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" />

                            <TextBlock Text="Пока ничего нового"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#293E58"
                                       TextAlignment="Center"
                                       Margin="0,16,0,0" />

                            <TextBlock Text="Загляни сюда немного позже."
                                       FontSize="14"
                                       Foreground="#687F99"
                                       TextAlignment="Center"
                                       Margin="0,6,0,0" />

                        </StackPanel>

                        <StackPanel x:Name="NewsErrorState"
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">

                            <Path Data="M6,18 A5,5 0 0 1 5,8                 A7,7 0 0 1 18,7                 A5.5,5.5 0 0 1 19,18                 M3,3 L21,21"
                                  Width="52"
                                  Height="52"
                                  Stretch="Uniform"
                                  Stroke="#829DBB"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" />

                            <TextBlock Text="Не удалось загрузить новости"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#293E58"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,16,0,0" />

                            <TextBlock Text="Проверь подключение к интернету и попробуй снова."
                                       FontSize="14"
                                       Foreground="#687F99"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="280"
                                       Margin="0,6,0,0" />

                            <Button x:Name="RetryNewsButton"
                                    Content="Повторить →"
                                    Style="{StaticResource TextButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,16,0,0" />

                        </StackPanel>

                        <StackPanel x:Name="NewsContainer"
                                    Visibility="Collapsed">
                            <StackPanel.Resources>
                                <Style TargetType="{x:Type local:AnnouncementCard}">
                                    <Setter Property="Margin"
                                            Value="0,6,6,6" />
                                </Style>
                            </StackPanel.Resources>
                        </StackPanel>
                    </Grid>

                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

</UserControl>
