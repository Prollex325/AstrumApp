<UserControl x:Class="AstrumApp.Controls.StepByStepControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstrumApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Width="400" Height="40">
        <TextBlock HorizontalAlignment="Right" FontFamily="Segoe UI" FontSize="13" FontWeight="Medium" Foreground="#9FB3C8">
            <Run Text="Шаг: "/>
            <Run x:Name="CurrentStepText" Text="" Foreground="#6FB6FF" FontWeight="SemiBold"/>
            <Run Text="/"/> 
            <Run x:Name="TotalStepsText" Text=""/>
        </TextBlock>
        <TextBlock x:Name="HintText" HorizontalAlignment="Left" FontFamily="Segoe UI" FontSize="13" FontWeight="Medium" 
                   Foreground="#9FB3C8"/>
        <UniformGrid x:Name="StepGrid" Width="400" Rows="1" VerticalAlignment="Bottom"/>

    </Grid>

</UserControl>
