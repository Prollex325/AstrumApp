<UserControl x:Class="AstrumApp.Controls.DragAndDrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstrumApp.Controls"
             mc:Ignorable="d" x:Name="root"
             d:DesignWidth="300" d:DesignHeight="200" Background="{x:Null}">
    <Border x:Name="DropZoneBorder" AllowDrop="True" Background="{Binding DropZoneBackground, ElementName=root}" 
            BorderBrush="{Binding DropZoneBorderBrush, ElementName=root}" CornerRadius="20" ClipToBounds="True" 
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DragEnter="DropZone_DragEnter" 
            MouseLeftButtonDown="DropZone_MouseLeftButtonDown" MouseLeftButtonUp="DropZone_MouseLeftButtonUp"
            DragLeave="DropZone_DragLeave" DragOver="DropZone_DragOver" Drop="DropZone_Drop" BorderThickness="3" 
            MouseEnter="DropZone_MouseEnter" MouseLeave="DropZone_MouseLeave"> 

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
            <TextBlock Text="📥" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Перетащите файл сюда" FontSize="16" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
            <TextBlock Text="или нажмите для просмотра" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
