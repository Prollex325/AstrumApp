<UserControl x:Class="AstrumApp.Controls.Seasonal.GarlandControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AstrumApp.Controls.Seasonal"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Canvas x:Name="GarlandCanvas"
            IsHitTestVisible="False"
            ClipToBounds="True"
            Loaded="GarlandCanvas_Loaded">

        <Path x:Name="GarlandWire"
              Stroke="#43534D"
              StrokeThickness="2" />

    </Canvas>

</UserControl>
