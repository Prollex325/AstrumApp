<UserControl x:Class="AstrumApp.Controls.NotificationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstrumApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="300">
    <Grid Width="300">
        <ItemsControl ItemsSource="{Binding Notifications}" x:Name="NotificationItemsControl">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="20"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid x:Name="LayoutContainer" Height="90" ClipToBounds="False">
                        <Border Margin="30, 0, 20, 40" Height="50" CornerRadius="20" Cursor="Hand" Loaded="Notification_Loaded"
                                MouseLeftButtonUp="Border_MouseLeftButtonUp" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush>
                                    <GradientStop Color="{Binding StartColor}" Offset="0"/>
                                    <GradientStop Color="{Binding EndColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <TranslateTransform X="250" Y="0"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="{Binding StartColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).BlurRadius" To="20" Duration="0:0:0.25"/>

                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).Opacity" To="0.9" Duration="0:0:0.25"/>

                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="5" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>

                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).BlurRadius" To="10" Duration="0:0:0.25"/>

                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).Opacity" To="0.6" Duration="0:0:0.25"/>

                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock Text="{Binding Text}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" 
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>
    </Grid>
</UserControl>
