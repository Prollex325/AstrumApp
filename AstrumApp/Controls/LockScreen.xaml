<UserControl x:Class="AstrumApp.Controls.LockScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstrumApp"
             mc:Ignorable="d" 
             Focusable="True"
             d:DesignHeight="585" d:DesignWidth="1040"
             KeyDown="UserControl_KeyDown">

    <Grid> <!-- изменить дизайн поля ввода на кружочки -->
        <!--<MediaElement  x:Name="WallPaperVideo" Source="Assets/video.mp4" LoadedBehavior="Play" UnloadedBehavior="Manual"  Width="1040" Height="585" MediaOpened="WallPaper_MediaOpened"
                                    MediaEnded="WallPaper_MediaEnded" Visibility="Hidden">
    <MediaElement.Effect>
        <BlurEffect Radius="0" x:Name="VideoBlurEffect"/>
    </MediaElement.Effect>
</MediaElement> -->
        <Image x:Name="WallPaperImg" Source="/Assets/wallpapers/lock-screen.png" Visibility="Visible" Stretch="Fill" Margin="0 0 0 0">
            <Image.Effect>
                <BlurEffect Radius="0" x:Name="ImageBlurEffect"/>
            </Image.Effect>
        </Image>

        <Rectangle Fill="Black" Opacity="0" x:Name="BlurRect"/>

        <Grid x:Name="GreetingBox" Opacity="0">
            <Border Background="#1A000000" CornerRadius="25" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.35"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="200" Height="200" CornerRadius="100" BorderThickness="2" BorderBrush="#55FFFFFF"
                            HorizontalAlignment="Center">
                        <Image Source="{Binding Avatar}"/>
                    </Border>

                    <TextBlock Text="{Binding Username}" Margin="0,0,0,10" FontSize="26" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" x:Name="GreetingTitle"/>

                    <PasswordBox x:Name="PasswordInput" MaxLength="4" PreviewTextInput="Password_PreviewTextInput" 
                                    PasswordChanged="PasswordInput_Changed" Opacity="0"/>

                    <StackPanel x:Name="PinDots" Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Ellipse}">
                                <Setter Property="Margin" Value="15, 0, 0, 15"/>
                                <Setter Property="Width" Value="15"/>
                                <Setter Property="Height" Value="15"/>
                                <Setter Property="Fill" Value="Gray"/>
                            </Style>
                        </StackPanel.Resources>
                        
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PinDotsTransform"/>
                        </StackPanel.RenderTransform>
                        <Ellipse x:Name="Dot1"/>
                        <Ellipse x:Name="Dot2"/>
                        <Ellipse x:Name="Dot3"/>
                        <Ellipse x:Name="Dot4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="InfoBox" Height="585" Width="1040" Background="Transparent" VerticalAlignment="Top"
              MouseLeftButtonDown="Main_MouseDown" MouseLeftButtonUp="Main_MouseUp" MouseMove="Main_MouseMove">
            <Grid.RenderTransform>
                <TranslateTransform X="0" Y="0" x:Name="ScreenTransform"/>
            </Grid.RenderTransform>
            <TextBlock x:Name="Clock" Text="HH:MM:SS" FontSize="48" FontWeight="Bold" Foreground="White" 
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 80 0 0" Visibility="Visible"/>
            <TextBlock x:Name="Date" Text="xx, day, xxxx" FontSize="32" FontWeight="Bold" Foreground="White" 
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 150 0 0" Visibility="Visible"/>
        </Grid>
    </Grid>
</UserControl>