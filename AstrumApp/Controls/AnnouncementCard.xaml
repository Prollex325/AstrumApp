<UserControl x:Class="AstrumApp.Controls.AnnouncementCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AstrumApp.Controls"
             mc:Ignorable="d"
             d:DesignWidth="400"
             x:Name="Root">

    <UserControl.Resources>
        <Style x:Key="TextButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="#4873A7" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Padding"
                    Value="0,3" />
            <Setter Property="HorizontalAlignment"
                    Value="Left" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">

                            <TextBlock x:Name="ButtonText"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonText"
                                        Property="Foreground"
                                        Value="#24558E" />

                                <Setter TargetName="ButtonText"
                                        Property="TextDecorations"
                                        Value="Underline" />
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonText"
                                        Property="Foreground"
                                        Value="#183A62" />
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonText"
                                        Property="Foreground"
                                        Value="#9CAABA" />
                                <Setter Property="Cursor"
                                        Value="Arrow" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#B3FFFFFF"
            BorderBrush="#E6FFFFFF"
            BorderThickness="1"
            CornerRadius="20"
            Padding="14">

        <StackPanel>

            <!--  ИЗОБРАЖЕНИЕ  -->
            <Border Height="200"
                    HorizontalAlignment="Stretch"
                    CornerRadius="14"
                    Margin="0,0,0,14">

                <Border.Background>
                    <ImageBrush ImageSource="{Binding ImageSource, ElementName=Root}"
                                Stretch="UniformToFill" />
                </Border.Background>

                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ImageSource, ElementName=Root}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

            </Border>

            <!--  КАТЕГОРИЯ И ДАТА  -->
            <DockPanel Margin="0,0,0,8">

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding PublishedAt, ElementName=Root, StringFormat={}{0:dd MMMM yyyy}, ConverterCulture=ru-RU}"
                           Foreground="#71849B"
                           FontSize="11"
                           VerticalAlignment="Center" />

                <!--  ФОН КАТЕГОРИИ  -->
                <Border HorizontalAlignment="Left"
                        CornerRadius="7"
                        Padding="9,4">

                    <Border.Style>
                        <Style TargetType="Border">

                            <Setter Property="Background"
                                    Value="#E5DDF5" />

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding Category, ElementName=Root}"
                                             Value="Update">
                                    <Setter Property="Background"
                                            Value="#D5EBDD" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Category, ElementName=Root}"
                                             Value="Event">
                                    <Setter Property="Background"
                                            Value="#D7E5F8" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Category, ElementName=Root}"
                                             Value="Important">
                                    <Setter Property="Background"
                                            Value="#F6E6CB" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Category, ElementName=Root}"
                                             Value="Maintenance">
                                    <Setter Property="Background"
                                            Value="#F5DDE0" />
                                </DataTrigger>

                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <!--  НАЗВАНИЕ И ЦВЕТ КАТЕГОРИИ  -->
                    <TextBlock FontSize="10"
                               FontWeight="SemiBold">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">

                                <Setter Property="Text"
                                        Value="НОВОСТЬ" />
                                <Setter Property="Foreground"
                                        Value="#7960AC" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Category, ElementName=Root}"
                                                 Value="Update">
                                        <Setter Property="Text"
                                                Value="ОБНОВЛЕНИЕ" />
                                        <Setter Property="Foreground"
                                                Value="#387A50" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Category, ElementName=Root}"
                                                 Value="Event">
                                        <Setter Property="Text"
                                                Value="СОБЫТИЕ" />
                                        <Setter Property="Foreground"
                                                Value="#4873A7" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Category, ElementName=Root}"
                                                 Value="Important">
                                        <Setter Property="Text"
                                                Value="ВАЖНОЕ" />
                                        <Setter Property="Foreground"
                                                Value="#A17B36" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Category, ElementName=Root}"
                                                 Value="Maintenance">
                                        <Setter Property="Text"
                                                Value="ТЕХНИЧЕСКИЕ РАБОТЫ" />
                                        <Setter Property="Foreground"
                                                Value="#AD515B" />
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </DockPanel>

            <!--  ЗАГОЛОВОК  -->
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       FontFamily="Segoe UI"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Foreground="#293E58"
                       TextWrapping="Wrap" />

            <!--  ОПИСАНИЕ  -->
            <TextBlock Text="{Binding Description, ElementName=Root}"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       FontWeight="Normal"
                       Foreground="#687F99"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,8,0,0">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>

                            <DataTrigger Binding="{Binding Description, ElementName=Root}"
                                         Value="">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Description, ElementName=Root}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>

            </TextBlock>

            <!--  КНОПКА И РАЗДЕЛИТЕЛЬ  -->
            <StackPanel>

                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>

                            <DataTrigger Binding="{Binding ActionText, ElementName=Root}"
                                         Value="">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding ActionText, ElementName=Root}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding ActionType, ElementName=Root}"
                                         Value="None">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Height="1"
                        Background="#18293E58"
                        Margin="0,12"
                        CornerRadius="2" />

                <Button Content="{Binding ActionText, ElementName=Root}"
                        Style="{StaticResource TextButtonStyle}"
                        Click="ActionButton_Click" />

            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
