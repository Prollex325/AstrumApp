<Window x:Class="AstrumApp.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstrumApp"
        mc:Ignorable="d"
        Title="Ошибка" Height="220" Width="420" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" Closed="Window_Closed">

    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1015" Offset="0"/>
            <GradientStop Color="#111923" Offset="0.5"/>
            <GradientStop Color="#0E141B" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderAccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1C2B3A" Offset="0"/>
            <GradientStop Color="#22384C" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#16222E"/>
            <Setter Property="BorderBrush" Value="#2A4156"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="95"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#203244"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3C5E7A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0F1A24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#28435A"/>
            <Setter Property="BorderBrush" Value="#4F7AA0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#365774"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#6A9AC8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1F3446"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#0E151D"/>
            <Setter Property="BorderBrush" Value="#1B2935"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#16212C"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#304657"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0A1016"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Foreground" Value="#C9D7E3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border CornerRadius="14" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="#26384A" BorderThickness="1.2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="58"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="{StaticResource HeaderAccentBrush}" BorderBrush="#2B4256"
                        BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="30" Height="30" CornerRadius="8" Background="#182633" VerticalAlignment="Center">
                            <Image x:Name="HeaderIconImage" Source="/Assets/dialogs/error.png" Width="18" Height="18" VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="HeaderTextBlock" Grid.Column="2" Text="Ошибка" Foreground="White" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="3" x:Name="CloseButton" Width="24" Height="24" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Click="CancelButton_Click" Style="{StaticResource CloseButton}"
                                Content="✕">
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="18,16,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                   <Border Width="50" Height="50" CornerRadius="10" Background="#13202B" BorderBrush="#233646" BorderThickness="1"
                            VerticalAlignment="Top" Margin="1">
                        <TextBlock Text="!" Foreground="#7DB3E6" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="MessageTextBlock" Text="Текст ошибки" Foreground="#D8E5F1" FontSize="14"
                               TextWrapping="Wrap" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="2" Margin="18,0,18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Content="Да" Style="{StaticResource PrimaryDialogButtonStyle}" Click="PositiveButton_Click"
                            x:Name="PositiveButton" Visibility="Collapsed"/>

                    <Button Grid.Column="3" Content="Нет" Style="{StaticResource DialogButtonStyle}" Click="NegativeButton_Click"
                            x:Name="NegativeButton" Visibility="Collapsed"/>

                    <Button Grid.Column="5" Content="Отмена" Style="{StaticResource CancelDialogButtonStyle}" Click="CancelButton_Click"
                            x:Name="CancelButton" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>