<Window x:Class="AstrumApp.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstrumApp"
        mc:Ignorable="d"
        Title="Ошибка"
        Height="220"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Closed="Window_Closed"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackgroundBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#0B1015"
                          Offset="0" />
            <GradientStop Color="#111923"
                          Offset="0.5" />
            <GradientStop Color="#0E141B"
                          Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderAccentBrush"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#1C2B3A"
                          Offset="0" />
            <GradientStop Color="#22384C"
                          Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="DialogButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Background"
                    Value="#16222E" />
            <Setter Property="BorderBrush"
                    Value="#2A4156" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Width"
                    Value="95" />
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#203244" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#3C5E7A" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#0F1A24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryDialogButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background"
                    Value="#28435A" />
            <Setter Property="BorderBrush"
                    Value="#4F7AA0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#365774" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#6A9AC8" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#1F3446" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelDialogButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background"
                    Value="#0E151D" />
            <Setter Property="BorderBrush"
                    Value="#1B2935" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#16212C" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#304657" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#0A1016" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton"
               TargetType="Button"
               BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Foreground"
                    Value="#C9D7E3" />
            <Setter Property="FontSize"
                    Value="12" />
        </Style>

        <!--  Destructive: отдельные стили только для нового макета  -->
        <Style x:Key="DestructiveCancelButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="#E5E9F1" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Background"
                    Value="#202B3A" />
            <Setter Property="BorderBrush"
                    Value="#4B5D73" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Height"
                    Value="42" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="#2C3C4E" />
                                <Setter TargetName="Chrome"
                                        Property="BorderBrush"
                                        Value="#7292AF" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="#19232E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DestructiveConfirmButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Background"
                    Value="#C93649" />
            <Setter Property="BorderBrush"
                    Value="#F26775" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Height"
                    Value="42" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="#DF4658" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="#A6293A" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="#602B35" />
                                <Setter TargetName="Chrome"
                                        Property="BorderBrush"
                                        Value="#80404B" />
                                <Setter Property="Foreground"
                                        Value="#C88F99" />
                                <Setter Property="Cursor"
                                        Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="NormalDialog"
              Margin="12"
              Visibility="Collapsed">
            <Border CornerRadius="14"
                    Background="{StaticResource WindowBackgroundBrush}"
                    BorderBrush="#26384A"
                    BorderThickness="1.2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="58" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            CornerRadius="14,14,0,0"
                            Background="{StaticResource HeaderAccentBrush}"
                            BorderBrush="#2B4256"
                            BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <Border Width="30"
                                    Height="30"
                                    CornerRadius="8"
                                    Background="#182633"
                                    VerticalAlignment="Center">
                                <Image x:Name="HeaderIconImage"
                                       Source="/Assets/dialogs/error.png"
                                       Width="18"
                                       Height="18"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                            </Border>

                            <TextBlock x:Name="HeaderTextBlock"
                                       Grid.Column="2"
                                       Text="Ошибка"
                                       Foreground="White"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="3"
                                    x:Name="CloseButton"
                                    Width="24"
                                    Height="24"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="CancelButton_Click"
                                    Style="{StaticResource CloseButton}"
                                    Content="✕" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          Margin="18,16,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="50"
                                Height="50"
                                CornerRadius="10"
                                Background="#13202B"
                                BorderBrush="#233646"
                                BorderThickness="1"
                                VerticalAlignment="Top"
                                Margin="1">
                            <TextBlock Text="!"
                                       Foreground="#7DB3E6"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <TextBlock x:Name="MessageTextBlock"
                                   Text="Текст ошибки"
                                   Foreground="#D8E5F1"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="2"
                          Margin="18,0,18,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                Content="Да"
                                Style="{StaticResource PrimaryDialogButtonStyle}"
                                Click="PositiveButton_Click"
                                x:Name="PositiveButton"
                                Visibility="Collapsed" />

                        <Button Grid.Column="3"
                                Content="Нет"
                                Style="{StaticResource DialogButtonStyle}"
                                Click="NegativeButton_Click"
                                x:Name="NegativeButton"
                                Visibility="Collapsed" />

                        <Button Grid.Column="5"
                                Content="Отмена"
                                Style="{StaticResource CancelDialogButtonStyle}"
                                Click="CancelButton_Click"
                                x:Name="CancelButton"
                                Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>


        <!--  Независимый макет для необратимых действий. Без анимаций и таймера.  -->
        <Grid x:Name="DestructiveDialog"
              Margin="12"
              Visibility="Visible"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True">

            <Border CornerRadius="14"
                    BorderBrush="#D9495D"
                    BorderThickness="1.3"
                    Background="#121A26"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="70" />
                    </Grid.RowDefinitions>

                    <!--  Заголовок: насыщенный красный, без свечения  -->
                    <Border Grid.Row="0"
                            Background="#5C222F"
                            BorderBrush="#BB4354"
                            BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown"
                            CornerRadius="14, 14, 0, 0">
                        <Grid Margin="20,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="26"
                                  Height="26"
                                  VerticalAlignment="Center">
                                <Path Data="M13,2 L24,22 L2,22 Z"
                                      Stroke="#FF7786"
                                      Fill="#A92D3E"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round" />
                                <TextBlock Text="!"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </Grid>

                            <TextBlock Grid.Column="1"
                                       Text="Удаление аккаунта"
                                       Foreground="#FFFFFF"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="CancelButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="HitArea"
                                                Background="Transparent"
                                                CornerRadius="6">
                                            <TextBlock Text="×"
                                                       Foreground="#E6C9CF"
                                                       FontSize="24"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,-3,0,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="HitArea"
                                                        Property="Background"
                                                        Value="#80404B" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!--  Основное сообщение  -->
                    <Grid Grid.Row="1"
                          Margin="23,18,23,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="62"
                                Height="66"
                                CornerRadius="12"
                                Background="#43242F"
                                BorderBrush="#823646"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <!--  Корзина без внешних иконок  -->
                            <Viewbox Width="37"
                                     Height="43"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="36"
                                        Height="42">
                                    <Path Data="M8,10 L10,37 Q10,39 13,39 L27,39 Q30,39 30,36 L32,10"
                                          Stroke="#FF6375"
                                          StrokeThickness="3.2"
                                          StrokeLineJoin="Round" />
                                    <Path Data="M5,9 L34,9 M13,8 L14,4 L25,4 L26,8 M16,16 L16,32 M24,16 L24,32"
                                          Stroke="#FF6375"
                                          StrokeThickness="3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock x:Name="DestructiveMessageTextBlock"
                                       Text="Вы собираетесь навсегда удалить аккаунт."
                                       TextWrapping="Wrap"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#F4F6FB" />
                            <TextBlock Text="Все связанные с ним данные, включая профиль и загруженные файлы, будут удалены без возможности восстановления."
                                       TextWrapping="Wrap"
                                       Margin="0,9,0,0"
                                       FontSize="13"
                                       LineHeight="19"
                                       Foreground="#AEBCCC" />
                        </StackPanel>
                    </Grid>

                    <!--  Короткое предупреждение, без полосы прогресса  -->
                    <Border Grid.Row="2"
                            Margin="23,0,23,0"
                            Padding="12,10"
                            Background="#30202A"
                            BorderBrush="#994054"
                            BorderThickness="1"
                            CornerRadius="9">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="23"
                                    Height="23"
                                    CornerRadius="12"
                                    Background="#D3495C">
                                <TextBlock Text="!"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Действие нельзя отменить"
                                       Foreground="#F7E6E9"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="9,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!--  Таймер отображается только в тексте кнопки. Его реализация — в C#.  -->
                    <Grid Grid.Row="3"
                          Margin="23,12,23,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="DestructiveCancelButton"
                                Grid.Column="2"
                                Width="Auto"
                                Style="{StaticResource DestructiveCancelButtonStyle}"
                                Content="Отмена"
                                Click="NegativeButton_Click" />

                        <Button x:Name="DestructiveConfirmButton"
                                Grid.Column="4"
                                Width="Auto"
                                Style="{StaticResource DestructiveConfirmButtonStyle}"
                                Content="Удалить (7)"
                                IsEnabled="False"
                                Click="PositiveButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
