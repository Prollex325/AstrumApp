<Application x:Class="AstrumApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstrumApp"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ResourceDictionaries/DefaultInput.xaml"/>
                <ResourceDictionary Source="/ResourceDictionaries/ButtonStyle.xaml"/>
                <ResourceDictionary Source="/ResourceDictionaries/ToggleStyles.xaml"/>
                <ResourceDictionary Source="/ResourceDictionaries/TextBoxStyle.xaml"/>
                <ResourceDictionary Source="/ResourceDictionaries/PasswordBoxStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
    