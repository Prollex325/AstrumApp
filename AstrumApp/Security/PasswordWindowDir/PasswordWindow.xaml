<Window x:Class="AstrumApp.Security.PasswordWindowDir.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstrumApp.Security"
        xmlns:controls="clr-namespace:AstrumApp.Controls"
        mc:Ignorable="d"
        Title="MessageWindow" Height="300" Width="450" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" Closed="Window_Closed" KeyDown="Window_KeyDown">
    
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1015" Offset="0"/>
            <GradientStop Color="#111923" Offset="0.5"/>
            <GradientStop Color="#0E141B" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderAccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1C2B3A" Offset="0"/>
            <GradientStop Color="#22384C" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#16222E"/>
            <Setter Property="BorderBrush" Value="#2A4156"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="95"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#203244"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3C5E7A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0F1A24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#28435A"/>
            <Setter Property="BorderBrush" Value="#4F7AA0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#365774"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#6A9AC8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1F3446"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#0E151D"/>
            <Setter Property="BorderBrush" Value="#1B2935"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#16212C"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#304657"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0A1016"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Foreground" Value="#C9D7E3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border CornerRadius="14" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="#26384A" BorderThickness="1.2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Заголовок -->
                <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="{StaticResource HeaderAccentBrush}" BorderBrush="#2B4256"
                        BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0" HorizontalAlignment="Stretch">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#263B50" HorizontalAlignment="Left">
                            <Grid Width="24" Height="24">
                                <!-- Контур щита -->
                                <Path Stroke="#79B7FF" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                   StrokeEndLineCap="Round"
                                   Data="M 12,2 L 20,5.5 V 11.5 C 20,17 16.5,20.5 12,22 C 7.5,20.5 4,17 4,11.5 V 5.5 Z"/>

                                <!-- Галочка -->
                                <Path Stroke="#79B7FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 8.5,12 L 11,14.5 L 16,9.5"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Подтверждение личности" FontFamily="Segoe UI Variable" FontSize="21"
                                   FontWeight="SemiBold" Foreground="#F4F7FB" TextOptions.TextFormattingMode="Display" 
                                   TextOptions.TextRenderingMode="ClearType" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="2,0,0,0"/>

                        <Button Width="25" Height="25" Cursor="Hand" HorizontalAlignment="Right" Click="CancelButton_Click"
                                Background="Transparent" BorderBrush="Transparent">
                            <Button.Content>
                                <Path Width="16" Height="16" Stroke="#8595A6"  StrokeThickness="2" StrokeStartLineCap="Round" 
                                      StrokeEndLineCap="Round" Data="M 3,3 L 13,13 M 13,3 L 3,13" Stretch="Uniform"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button.Content>
                        </Button>
                    </Grid>
                </Border>

                <!-- Основное тело -->
                <Border Grid.Row="1" CornerRadius="10" Background="{StaticResource HeaderAccentBrush}" BorderBrush="#2B4256"
                        BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="10">
                    <StackPanel Margin="10,0,10,0">
                        <TextBlock Text="Для продолжения введите пароль от вашего аккаунта Astrum."  FontFamily="Segoe UI Variable"
                                   FontSize="13" FontWeight="Normal" Foreground="#9DAFC0" TextWrapping="Wrap" LineHeight="19"
                                   LineStackingStrategy="BlockLineHeight" TextOptions.TextFormattingMode="Display" Margin="10"
                                   x:Name="InfoText"/>

                        <controls:InputField x:Name="PasswordInput" Placeholder="Пароль" IsPassword="True" ShowPasswordButton="True" 
                                             Margin="0,0,0,10" IsRequiered="False" Width="250" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Навигационные кнопки -->
                <Border Grid.Row="2" CornerRadius="10" Background="{StaticResource HeaderAccentBrush}" BorderBrush="#2B4256"
                         BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="10,0,10,10">
                    <Grid HorizontalAlignment="Stretch">
                        <Button Content="Отмена" Width="150" HorizontalAlignment="Left" Margin="20,0,0,0"
                                Click="CancelButton_Click"/>
                        <Button x:Name="ConfirmButton" Content="Подтвердить" Background="#4A8DFF" Width="150" 
                                HorizontalAlignment="Right" Margin="0,0,20,0" Click="ConfirmButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid> 
</Window>
