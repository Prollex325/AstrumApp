<UserControl x:Class="AstrumApp.Apps.Authentication.BioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AstrumApp.Apps.Authentication"
      xmlns:controls="clr-namespace:AstrumApp.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="300">

    <Border Width="300" Height="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5"
            CornerRadius="22" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1B222A" Offset="0"/>
                <GradientStop Color="#FF2A3642" Offset="0.5"/>
                <GradientStop Color="#FF1F2A33" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="#22FFFFFF"/>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>
        

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0"
                    Background="Transparent" Cursor="Hand" Panel.ZIndex="1" MouseLeftButtonDown="Path_MouseLeftButtonDown">

                <Path x:Name="BackButton" Width="20" Height="20" Stroke="#9FB3C8" StrokeThickness="2" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 17,10 L 4,10 M 4,10 L 10,4 M 4,10 L 10,16"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Row="0" Text="Расскажите о себе" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Center" 
                   Margin="0, 20, 0, 0" FontSize="25" FontWeight="Bold"/>

            <StackPanel Grid.Row="1" Margin="0, 20, 0, 0">
                <controls:InputField x:Name="NameTextBox" Placeholder="Имя" Margin="20,0" IsRequiered="True"/>

                <controls:InputField x:Name="BioTextBox" Placeholder="О себе" Margin="20,10,20,0"
                     Height="120" MaxLength="160" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <Button x:Name="NextButton" Content="Далее" Grid.Row="2" Width="160" Background="#4A8DFF" 
                    Foreground="White" BorderBrush="#35FFFFFF" Click="NextButton_Click"/>
        </Grid>
    </Border>
</UserControl>
