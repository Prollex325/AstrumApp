<Page x:Class="AstrumApp.Apps.Authentication.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AstrumApp.Apps.Authentication"
      xmlns:controls="clr-namespace:AstrumApp.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Border Width="300" Height="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5" CornerRadius="22" 
            BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1B222A" Offset="0"/>
                <GradientStop Color="#FF2A3642" Offset="0.5"/>
                <GradientStop Color="#FF1F2A33" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="#22FFFFFF"/>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="15"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Авторизация" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Center" 
                       Margin="0, 20, 0, 0" FontSize="30" FontWeight="Bold"/>

            <StackPanel Grid.Row="1" Margin="0, 30, 0, 0">
                <controls:InputField x:Name="EmailTextBox" Placeholder="Почта" Margin="20,0"/>
                <controls:InputField x:Name="PasswordBox" Placeholder="Пароль" IsPassword="True" ShowPasswordButton="True" 
                             Margin="20,20,20,0"/>
            </StackPanel>

            <Button x:Name="AuthButton" Content="Авторизоваться" Grid.Row="2" Width="160" Background="#4A8DFF" 
                    Foreground="White" BorderBrush="#35FFFFFF" Click="AuthButton_Click"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-8,0,0">

                <TextBlock Text="Нет аккаунта? " FontSize="11" Foreground="#8292A6"/>

                <TextBlock Text="Зарегистрируйтесь" FontSize="11" FontWeight="SemiBold" Foreground="#4A8DFF" Cursor="Hand"
                           MouseLeftButtonDown="TextBlock_MouseLeftButtonDown">

                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Foreground.Color" To="#70A7FF" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Foreground.Color" To="#4A8DFF" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>

                </TextBlock>

            </StackPanel>
        </Grid>
    </Border>
</Page>
