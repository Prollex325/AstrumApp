<UserControl x:Class="AstrumApp.Apps.Authentication.SelectProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AstrumApp.Apps.Settings.MenuControls.ProfileOptions"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="GetLocalAccounts">

    <UserControl.Resources>

        <DataTemplate x:Key="AccountCardTemplate">

            <Button x:Name="AccountButton"
                    Height="76"
                    Margin="10,2"
                    Padding="10"
                    Style="{x:Null}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Cursor="Hand"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SelectProfile">

                <Button.Template>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="CardBorder"
                                Background="#1B2630"
                                CornerRadius="12"
                                BorderBrush="Transparent"
                                BorderThickness="1">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>

                        <ControlTemplate.Triggers>

                            <!--  Наведение  -->
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#354858" />
                            </Trigger>

                            <!--  Нажатие  -->
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#1B2731" />
                            </Trigger>

                            <!--  Активный аккаунт  -->
                            <DataTrigger Binding="{Binding IsActive}"
                                         Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#2D4051" />
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#258CF4" />
                            </DataTrigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Button.Template>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>

                    <!--  Аватар  -->
                    <Grid x:Name="AvatarContainer"
                          Width="48"
                          Height="48">
                        <Ellipse Fill="#40515F" />

                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Avatar}"
                                            Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <!--  Данные аккаунта  -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="8,0">

                        <TextBlock Text="{Binding Username}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="{Binding Email}"
                                   FontSize="13"
                                   Foreground="#AABBC6"
                                   TextTrimming="CharacterEllipsis" />

                    </StackPanel>

                    <!--  Галочка  -->
                    <TextBlock x:Name="ActiveMark"
                               Grid.Column="2"
                               Text="✓"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#258CF4"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed" />
                    <Path x:Name="ArrowMark"
                          Grid.Column="2"
                          Data="M 4 2 L 8 6 L 4 10"
                          StrokeThickness="1.8"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          RenderTransformOrigin="0.5 0.5">
                        <Path.RenderTransform>
                            <TranslateTransform X="0" />
                        </Path.RenderTransform>

                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke"
                                        Value="#729BB9" />

                                <Style.Triggers>

                                    <!--  Наведение на карточку  -->
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Value="True">

                                        <Setter Property="Stroke"
                                                Value="#258CF4" />

                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="4"
                                                                     Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>

                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="0"
                                                                     Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>

                                    </DataTrigger>

                                    <!--  Нажатие  -->
                                    <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Value="True">

                                        <Setter Property="Stroke"
                                                Value="#1D78CC" />

                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Button>

            <DataTemplate.Triggers>

                <DataTrigger Binding="{Binding IsActive}"
                             Value="True">
                    <Setter TargetName="ActiveMark"
                            Property="Visibility"
                            Value="Visible" />
                    <Setter TargetName="ArrowMark"
                            Property="Visibility"
                            Value="Collapsed" />
                    <!--  Размер карточки  -->
                    <Setter TargetName="AccountButton"
                            Property="Height"
                            Value="96" />
                    <Setter TargetName="AccountButton"
                            Property="Cursor"
                            Value="Arrow" />

                    <!--  Размер аватара  -->
                    <Setter TargetName="AvatarContainer"
                            Property="Width"
                            Value="58" />

                    <Setter TargetName="AvatarContainer"
                            Property="Height"
                            Value="58" />
                </DataTrigger>

            </DataTemplate.Triggers>

        </DataTemplate>

    </UserControl.Resources>

    <Grid Width="500"
          MaxHeight="400"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
          Margin="0,0,0,20"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">

        <!--  Фон, рамка и тень  -->
        <Border CornerRadius="22"
                BorderThickness="1"
                BorderBrush="#22FFFFFF"
                IsHitTestVisible="False">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Color="#FF1B222A"
                                  Offset="0" />
                    <GradientStop Color="#FF2A3642"
                                  Offset="0.5" />
                    <GradientStop Color="#FF1F2A33"
                                  Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  ShadowDepth="0"
                                  Opacity="0.35" />
            </Border.Effect>
        </Border>

        <StackPanel Margin="12,16,12,12">

            <ItemsControl x:Name="AccountsList"
                          ItemTemplate="{StaticResource AccountCardTemplate}" />

            <Border Height="1"
                    Background="#455563"
                    Margin="10,15" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Зарегистрироваться"
                        Click="ToRegisterPage" />

                <Button Grid.Column="1"
                        Content="Авторизоваться"
                        Click="ToLoginPage" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
