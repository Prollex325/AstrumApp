<UserControl x:Class="AstrumApp.Apps.Authentication.SetAvatarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AstrumApp.Apps.Authentication"
      xmlns:controls="clr-namespace:AstrumApp.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <controls:CropAndSaveImage Title="Установите аватар" Mode="Registration" x:Name="AvatarPicker"/>
    </Grid>
</UserControl>
