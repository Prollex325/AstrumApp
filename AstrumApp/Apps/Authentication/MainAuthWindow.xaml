<Page x:Class="AstrumApp.Apps.Authentication.MainAuthWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AstrumApp.Apps.Authentication"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainAuthWindow">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1015" Offset="0"/>
                <GradientStop Color="#111923" Offset="0.5"/>
                <GradientStop Color="#0E141B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Frame x:Name="Main" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
