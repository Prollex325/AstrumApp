<UserControl x:Class="AstrumApp.Apps.Authentication.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AstrumApp.Apps.Authentication"
      mc:Ignorable="d" 
      xmlns:controls="clr-namespace:AstrumApp.Controls"
      d:DesignHeight="450" d:DesignWidth="300">

    <Border Width="300" Height="450" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5"
                CornerRadius="22" BorderThickness="1" Margin="0,0,0,20">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1B222A" Offset="0"/>
                <GradientStop Color="#FF2A3642" Offset="0.5"/>
                <GradientStop Color="#FF1F2A33" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="#22FFFFFF"/>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,20,0,0"
                    Background="Transparent" Cursor="Hand" Panel.ZIndex="1" MouseLeftButtonDown="Path_MouseLeftButtonDown">

                <Path x:Name="BackButton" Width="20" Height="20" Stroke="#9FB3C8" StrokeThickness="2" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 17,10 L 4,10 M 4,10 L 10,4 M 4,10 L 10,16"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Row="0" Text="Регистрация" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Center" 
                           Margin="0, 20, 0, 0" FontSize="32" FontWeight="Bold"/>

            <StackPanel Grid.Row="1" Margin="0, 20, 0, 0">
                <controls:InputField x:Name="EmailTextBox" Placeholder="Почта" Margin="20,0" IsRequiered="True" 
                                     PreviewTextInput="EmailBox_PreviewTextInput"/>
                <controls:InputField x:Name="PasswordBox" Placeholder="Пароль" IsPassword="True" ShowPasswordButton="True" 
                                         Margin="20,0,20,0" IsRequiered="True"/>
                <controls:InputField x:Name="ConfirmPasswordBox" Placeholder="Повтор пароля" IsPassword="True" ShowPasswordButton="True" 
                         Margin="20,0,20,0" IsRequiered="True"/>
            </StackPanel>

            <Button x:Name="NextButton" Grid.Row="2" Content="Далее"  Background="#4A8DFF" Foreground="White" 
                        BorderBrush="#35FFFFFF" Click="NextButton_Click" Margin="10"/>


            <StackPanel x:Name="RegisterHint" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">

                <TextBlock Text="Уже есть аккаунт? " FontSize="11" Foreground="#8292A6"/>

                <TextBlock Text="Авторизуйтесь" FontSize="11" FontWeight="SemiBold" Foreground="#4A8DFF" Cursor="Hand"
                           MouseLeftButtonDown="TextBlock_MouseLeftButtonDown">

                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Foreground.Color" To="#70A7FF" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Foreground.Color" To="#4A8DFF" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>

                </TextBlock>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
