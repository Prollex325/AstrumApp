<UserControl x:Class="AstrumApp.Apps.Authentication.UserCardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstrumApp.Apps.Authentication"
             xmlns:controls="clr-namespace:AstrumApp.Controls"
             xmlns:settingsControls="clr-namespace:AstrumApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

        <!-- Основная карточка -->
        <controls:UserCard x:Name="UserCardControl" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0"/>

        <!-- Кнопки -->
        <Grid Margin="0,20,0,0">
            <Button x:Name="BackButton" Width="150" Height="46" HorizontalAlignment="Left" Content="Назад" Click="BackButton_Click"/>

            <Button x:Name="ConfirmButton" Width="180" Height="46" HorizontalAlignment="Right"  Content="Зарегистрироваться"
                    Click="ConfirmButton_Click" Background="#4A8DFF" Foreground="White" BorderBrush="#35FFFFFF"/>
        </Grid>

    </StackPanel>
</UserControl>
