<UserControl x:Class="AstrumApp.Apps.Settings.MainSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstrumApp.Apps.Settings"
             xmlns:controls="clr-namespace:AstrumApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="585" d:DesignWidth="1040"
             x:Name="SettingsControl">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1015" Offset="0"/>
                <GradientStop Color="#111923" Offset="0.5"/>
                <GradientStop Color="#0E141B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="0" Color="#000000" Opacity="0.4"/>
        </Grid.Effect>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <local:LeftPanel x:Name="LeftPanelControl" Grid.Column="0" Grid.Row="0"/>

        <Grid Grid.Column="1" Grid.Row="0" x:Name="RightGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" ClipToBounds="True"
                    Background="#1A2229" Margin="6, 6, 6, 0" Height="70">
                <controls:BreadcrumbControl/>
            </Border>
            
            <ContentControl x:Name="MenuPageHost" Grid.Row="1" ClipToBounds="False" Margin="10" Background="White"/>
        </Grid>
    </Grid>

</UserControl>
