<UserControl x:Class="AstrumApp.Apps.Settings.MenuControls.Security.CreatePinPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstrumApp.Apps.Settings.MenuControls.Security"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="20" BorderBrush="#22FFFFFF" 
                BorderThickness="1" Padding="80, 30, 80, 30">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1C2530" Offset="0"/>
                    <GradientStop Color="#18212B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel>
                <PasswordBox x:Name="PasswordBox" Width="160" Height="60" Padding="8" MaxLength="4" 
                             Style="{StaticResource PasswordBoxStyleSecurity}" Tag="Новый PIN" PasswordChanged="PasswordBox_PasswordChanged"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Width="160" Height="60" Padding="8" MaxLength="4" Margin="0,10,0,0"
                             Style="{StaticResource PasswordBoxStyleSecurity}" Tag="Подтвердите PIN" PasswordChanged="PasswordBox_PasswordChanged"/>
                
                <Button x:Name="CreatePinButton" Content="Создать PIN" Width="160" Height="35" Margin="0,20,0,0" Click="CreatePin_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
