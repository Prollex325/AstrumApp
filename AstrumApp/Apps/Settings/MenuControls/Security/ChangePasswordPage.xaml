<UserControl x:Class="AstrumApp.Apps.Settings.MenuControls.Security.ChangePasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstrumApp.Apps.Settings.MenuControls.Security"
             xmlns:controls="clr-namespace:AstrumApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="20" BorderBrush="#22FFFFFF" 
            BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1C2530" Offset="0"/>
                <GradientStop Color="#18212B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <StackPanel HorizontalAlignment="Stretch" Margin="80, 30, 80, 30" Width="200">
            <controls:InputField x:Name="NewPasswordBox" Placeholder="Новый пароль" IsPassword="True" ShowPasswordButton="True" 
                                Margin="0,10,0,0" IsRequiered="False" MaxLength="16"/>
            <controls:InputField x:Name="ConfirmPasswordBox" Placeholder="Подтвердите пароль" IsPassword="True" ShowPasswordButton="True" 
                                Margin="0,10,0,0" IsRequiered="False" MaxLength="16"/>

            <Button x:Name="ChangePasswordButton" Content="Изменить пароль" Width="160" Height="35" Margin="0,20,0,0" Click="ChangePassword_Click"/>
        </StackPanel>
    </Border>
</UserControl>
