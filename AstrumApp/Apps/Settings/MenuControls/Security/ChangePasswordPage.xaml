<UserControl x:Class="AstrumApp.Apps.Settings.MenuControls.Security.ChangePasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AstrumApp.Apps.Settings.MenuControls.Security"
             xmlns:controls="clr-namespace:AstrumApp.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Unloaded="UnloadedWin">
    <Border HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="20"
            BorderBrush="#22FFFFFF"
            BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="0,1">
                <GradientStop Color="#1C2530"
                              Offset="0" />
                <GradientStop Color="#18212B"
                              Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid HorizontalAlignment="Stretch"
              Margin="80,30,80,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:InputField Grid.Row="0"
                                 x:Name="NewPasswordBox"
                                 Placeholder="Новый пароль"
                                 IsPassword="True"
                                 ShowPasswordButton="True"
                                 Margin="0,10,0,0"
                                 IsRequiered="False"
                                 MaxLength="16" />
            <controls:InputField Grid.Row="1"
                                 x:Name="ConfirmPasswordBox"
                                 Placeholder="Подтвердите пароль"
                                 IsPassword="True"
                                 ShowPasswordButton="True"
                                 Margin="0,10,0,0"
                                 IsRequiered="False"
                                 MaxLength="16" />

            <Grid Margin="0,20,0,0"
                  Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        x:Name="ChangePasswordButton"
                        Content="Изменить пароль"
                        Click="ChangePassword_Click" />
                <Button Grid.Row="1"
                        x:Name="CancelButton"
                        Content="Отмена"
                        Click="Cancel_Click" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
