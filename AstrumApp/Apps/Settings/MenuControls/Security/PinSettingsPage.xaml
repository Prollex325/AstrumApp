<UserControl x:Class="AstrumApp.Apps.Settings.MenuControls.Security.PinSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstrumApp.Apps.Settings.MenuControls.Security"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="Page_Loaded">

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="20" BorderBrush="#22FFFFFF" 
                BorderThickness="1" Padding="80, 30, 80, 30">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1C2530" Offset="0"/>
                    <GradientStop Color="#18212B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>

                <Button x:Name="CreatePinButton" Content="Задать PIN" Width="160" Height="35" Background="#4A8DFF" 
                        Foreground="White" BorderBrush="#35FFFFFF" Click="CreatePinButton_Click" Margin="0,0,0,30"/>

                <Button x:Name="ChangePinButton" Content="Изменить PIN" Width="160" Height="35" Click="ChangePinButton_Click" 
                        Margin="0,0,0,30"/>

                <Button x:Name="DeletePinButton" Content="Удалить PIN" Width="160" Height="35" Background="#3A2024" 
                        Foreground="#FF7777" BorderBrush="#55FF5555" Margin="0" Click="DeletePinButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
