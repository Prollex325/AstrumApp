<UserControl x:Class="AstrumApp.Apps.Settings.MenuControls.ProfileEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstrumApp.Apps.Settings.MenuControls"
             xmlns:controls="clr-namespace:AstrumApp.Controls"
             mc:Ignorable="d" Loaded="Load"
             d:DesignHeight="540" d:DesignWidth="820">
    
    <UserControl.Resources>

        <Style TargetType="ScrollBar">

            <Setter Property="Width" Value="8"/>
            <Setter Property="Margin" Value="0,3,3,3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" CornerRadius="10" Background="#3F5670"/>
                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#506B88"/>
                                                    </Trigger>

                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#5D7DA3"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>

                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="#D2E3F3"/>
            <Setter Property="Background" Value="#2B3C4D"/>
            <Setter Property="BorderBrush" Value="#3F5670"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3478F6"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4A8DFF" Offset="0"/>
                        <GradientStop Color="#3478F6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#5A9BFF"/>

                                <Setter TargetName="Border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#63A4FF" Offset="0"/>
                                            <GradientStop Color="#4A8DFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2F6FE5"/>

                                <Setter TargetName="Border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3478F6" Offset="0"/>
                                            <GradientStop Color="#2F6FE5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#344052"/>

                                <Setter TargetName="Border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#2C3442" Offset="0"/>
                                            <GradientStop Color="#222936" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>

                                <Setter Property="Foreground" Value="#7E8798"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Border Margin="0" Padding="20" CornerRadius="20" BorderBrush="#22FFFFFF" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1C2530" Offset="0"/>
                    <GradientStop Color="#18212B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="10, 0, 0, 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Настройте свой профиль" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left">
                        <StackPanel>
                            <controls:InputField TextContent="{Binding PendingUsername, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="350" MaxLength="16" Placeholder="Имя пользователя" Margin="0,0,0,20"/>

                            <controls:InputField TextContent="{Binding PendingEmail, UpdateSourceTrigger=PropertyChanged}" Width="350" 
                                                 MaxLength="254" Placeholder="Почта" Margin="0,0,0,20"/>

                            <controls:InputField TextContent="{Binding PendingBio, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="350" Height="120" MaxLength="160" AcceptsReturn="True" Placeholder="О себе"
                                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Padding="8" Width="220" Height="280" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="24" BorderThickness="2">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>

                        <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1D2732" Offset="0"/>
                            <GradientStop Color="#18212B" Offset="0.5"/>
                            <GradientStop Color="#121920" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                        <Border.BorderBrush>
                            <LinearGradientBrush x:Name="AnimatedBrush" StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#22FFFFFF" Offset="0"/>
                                <GradientStop Color="#4DA3FF" Offset="0.5"/>
                                <GradientStop Color="#22FFFFFF" Offset="1"/>

                                <LinearGradientBrush.RelativeTransform>
                                    <TranslateTransform x:Name="BrushTransform" X="-1"/>
                                </LinearGradientBrush.RelativeTransform>
                            </LinearGradientBrush>
                        </Border.BorderBrush>

                        <Border.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard x:Name="EnterHoverStoryboard">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="BrushTransform" Storyboard.TargetProperty="X"
                                                         To="1" Duration="0:0:0.7"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.3"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard x:Name="LeaveHoverStoryboard">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="BrushTransform" Storyboard.TargetProperty="X"
                                                         To="-1" Duration="0:0:0.7"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.3"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.28" Color="#000000"/>
                        </Border.Effect>

                        <Grid>
                            <Ellipse Width="140" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-70,-70,0"
                                         IsHitTestVisible="False" Opacity="0.12">

                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#4DA3FF" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel>

                                <Border Width="200" Height="200" CornerRadius="100" BorderBrush="#33FFFFFF" BorderThickness="3">
                                    <Image Source="{Binding PendingAvatar, UpdateSourceTrigger=PropertyChanged}" Stretch="UniformToFill"/>
                                </Border>

                                <Button Width="150" Height="42" Content="Изменить" Foreground="White" BorderThickness="0" Click="EditAvatar_Click"
                                            Cursor="Hand" FontWeight="SemiBold" FontSize="14" Margin="0,15,0,0" RenderTransformOrigin="0.5,0.5">

                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4A8DFF" Offset="0"/>
                                            <GradientStop Color="#3478F6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>

                                    <Button.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" x:Name="ButtonScaleTransform"/>
                                    </Button.RenderTransform>

                                    <Button.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.3"/>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.3"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"/>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                        <EventTrigger RoutedEvent="Button.Click">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.1" AutoReverse="True"/>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.1" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Button.Triggers>

                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">

                                            <Border x:Name="ButtonBorder" CornerRadius="14" Background="{TemplateBinding Background}">
                                                <Grid>

                                                    <!-- top glow -->
                                                    <Border Height="16" VerticalAlignment="Top" CornerRadius="14,14,0,0" Opacity="0.18">

                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="White" Offset="0"/>
                                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>

                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                </Grid>

                                            </Border>

                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отменить" Margin="0,0,8,0" Style="{StaticResource ButtonBase}" Click="DiscardChanges_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">

                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#3F5670"/>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#506B88"/>
                                        </Trigger>

                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#506B88"/>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#5D7DA3"/>
                                        </Trigger>

                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Сохранить" x:Name="SaveButton"  BorderThickness="1" Style="{StaticResource PrimaryButton}" Click="SaveChanges_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
