<UserControl x:Class="AstrumApp.Apps.Settings.MenuControls.NotFoundPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstrumApp.Apps.Settings.MenuControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid MouseLeftButtonDown="Grid_MouseLeftButtonDown" Cursor="Hand" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Background="Transparent">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Page Not Found" FontSize="36" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Страница не найдена" FontSize="36" Foreground="White" HorizontalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="*Нажимте на страницу для возврата" FontSize="16" Foreground="Gray" HorizontalAlignment="Left" 
                   VerticalAlignment="Bottom"/>

        <Grid Width="50" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0, 0, 10, 10" Opacity="0">

            <Ellipse Stroke="#22FFFFFF" StrokeThickness="4"/>

            <Path x:Name="ProgressPath" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <TextBlock x:Name="TimerText" Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
        </Grid>
    </Grid>
</UserControl>
