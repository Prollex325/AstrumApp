<UserControl x:Class="AstrumApp.Apps.Settings.MenuControls.AvatarEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstrumApp.Apps.Settings.MenuControls"
             xmlns:controls="clr-namespace:AstrumApp.Controls"
             mc:Ignorable="d" Unloaded="Unload"
             d:DesignHeight="540" d:DesignWidth="832">

    <UserControl.Resources>
        <Style x:Key="EditProfileTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10, 10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#10171F"/>
            <Setter Property="CaretBrush" Value="#6FB6FF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Tag" Value="None"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="14" FontWeight="SemiBold" Foreground="#9FB3C8" 
                                   Margin="2,0,0,0" Grid.Row="0" x:Name="TagTextBlock"/>

                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="14" BorderThickness="1.2"
                                Grid.Row="1">
                                <Border.BorderBrush>
                                    <SolidColorBrush x:Name="BorderBrushColor" Color="#2B3C4D"/>
                                </Border.BorderBrush>
                                <Grid>
                                    <Border Height="14" VerticalAlignment="Top" CornerRadius="14,14,0,0" Opacity="0.06">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="White" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BorderBrushColor" Storyboard.TargetProperty="Color" 
                                                    To="#3F5670" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetName="TagTextBlock" Storyboard.TargetProperty="Foreground.Color" 
                                                    To="#B3C7DA" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BorderBrushColor" Storyboard.TargetProperty="Color" 
                                                    To="#2B3C4D" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetName="TagTextBlock" Storyboard.TargetProperty="Foreground.Color" 
                                                    To="#9FB3C8" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#506B88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">

            <Setter Property="Width" Value="8"/>
            <Setter Property="Margin" Value="0,3,3,3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" CornerRadius="10" Background="#3F5670"/>
                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#506B88"/>
                                                    </Trigger>

                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#5D7DA3"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>

                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="#D2E3F3"/>
            <Setter Property="Background" Value="#2B3C4D"/>
            <Setter Property="BorderBrush" Value="#3F5670"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#506B88"/>
                                <Setter TargetName="Border" Property="Background" Value="#3F5670">
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2B3C4D"/>
                                <Setter TargetName="Border" Property="Background" Value="#506B88"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AcceptButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3478F6"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4A8DFF" Offset="0"/>
                        <GradientStop Color="#3478F6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#5A9BFF"/>

                                <Setter TargetName="Border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#63A4FF" Offset="0"/>
                                            <GradientStop Color="#4A8DFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2F6FE5"/>

                                <Setter TargetName="Border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3478F6" Offset="0"/>
                                            <GradientStop Color="#2F6FE5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White" CornerRadius="7"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="TrackBackground" Background="LightGray" Height="4" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton ClickMode="Press" Opacity="0" Command="{x:Static Slider.DecreaseSmall}"/>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton ClickMode="Press" Opacity="0" Command="{x:Static Slider.IncreaseSmall}"/>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiscargingButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#4A3134"/>
            <Setter Property="BorderBrush" Value="#6A474B"/>
            <Setter Property="Foreground" Value="#F0D6D8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#7A5358"/>

                                <Setter TargetName="Border" Property="Background" Value="#5A3B3F"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4A3C3F"/>

                                <Setter TargetName="Border" Property="Background" Value="#342B2D">
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Border Margin="0" Padding="25" CornerRadius="20" BorderBrush="#22FFFFFF" BorderThickness="1"
                Grid.Row="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1C2530" Offset="0"/>
                    <GradientStop Color="#18212B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Редактирование аватара" FontSize="30" FontWeight="SemiBold" Foreground="White"/>

                    <Grid Grid.Row="1" Margin="0,20,0,30" ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Column="0" Grid.Row="1" CornerRadius="24" BorderThickness="1" BorderBrush="#22FFFFFF" Width="290" Height="290">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A2330" Offset="0"/>
                                    <GradientStop Color="#141C26" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid x:Name="AvatarEditor" Margin="15" MouseLeftButtonDown="Avatar_MouseDown" MouseMove="Avatar_MouseMove" 
                                  MouseLeftButtonUp="Avatar_MouseUp" MouseWheel="Avatar_MouseWheel" Width="260" Height="260" ClipToBounds="False">
                                <Canvas Width="260" Height="260">
                                    <Image x:Name="AvatarImage" HorizontalAlignment="Left" Stretch="None" VerticalAlignment="Top" Cursor="Hand">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1" x:Name="AvatarScale"/>
                                                <TranslateTransform X="0" Y="0" x:Name="AvatarTranslate"/>
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                </Canvas>

                                <Path Fill="#80000000">
                                    <Path.Data>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <RectangleGeometry Rect="0,0,260,260"/>
                                            </CombinedGeometry.Geometry1>

                                            <CombinedGeometry.Geometry2>
                                                <EllipseGeometry Center="130,130" RadiusX="125" RadiusY="125"/>
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Path.Data>
                                </Path>

                                <Ellipse Width="250" Height="250" Stroke="#33FFFFFF" StrokeThickness="3" HorizontalAlignment="Center" 
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <controls:DragAndDrop x:Name="DragAndDropControl" Grid.Row="0" DropZoneBackground="#151E29" Width="300" Height="143"/>
                            
                            <Grid Grid.Row="1" Width="300" MouseWheel="Zoom_MouseWheel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" MouseLeftButtonUp="Border_MouseLeftButtonUp" Tag="Minus" 
                                        Background="Transparent">
                                    <Path Width="16" Height="16" Stroke="#D2E3F3" StrokeThickness="2.5" StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round" Data="M 3,8 L 13,8" Stretch="Fill"/>
                                </Border>

                                <Slider Visibility="Visible" x:Name="ZoomSlider" Grid.Column="1" Minimum="0.5" Maximum="3" 
                                        Value="1" HorizontalAlignment="Stretch" ValueChanged="ZoomSlider_ValueChanged"
                                        Style="{StaticResource SliderStyle}" IsMoveToPointEnabled="True"/>

                                <Border Grid.Column="2" MouseLeftButtonUp="Border_MouseLeftButtonUp" Tag="Plus" Background="Transparent">
                                    <Path Stroke="#D2E3F3" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                            Data="M 3,8 L 13,8 M 8,3 L 8,13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="3" Text="{Binding Value, ElementName=ZoomSlider, StringFormat={}{0:P0}}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"
                                            FontSize="14" FontWeight="Bold"/>
                            </Grid>
                            
                            <Grid Width="320" Grid.Row="2">
                                <!--<Button x:Name="" Content="&#xE722;" FontSize="32" HorizontalAlignment="Left" Height="56" 
                                        Style="{StaticResource AcceptButton}" FontFamily="Segoe Fluent Icons" Margin="0,0,10,0"
                                        Click="OpenImage_Click" VerticalAlignment="Top"/>-->
                                <Button Content="&#xE74E;" FontSize="32" HorizontalAlignment="Left" Style="{StaticResource AcceptButton}" 
                                        Height="46" FontFamily="Segoe Fluent Icons" VerticalAlignment="Top" Margin="10,0,0,0"
                                        Click="SaveImage_Click"/>
                                <Button x:Name="DeleteButton" Content="&#xE74D;" FontSize="32" HorizontalAlignment="Right" Height="46" 
                                        Style="{StaticResource DiscargingButton}" FontFamily="Segoe Fluent Icons" Margin="0,0,10,0"
                                        VerticalAlignment="Top" Click="DiscardChanges_Click"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
                <TextBlock x:Name="ImageHint" Grid.Row="1" Text="Совет: квадратные изображения лучше подходят для аватаров." 
                           FontSize="14" Foreground="#9FB3C8" TextWrapping="Wrap" Margin="0,-10,0,0" Opacity="0"/>
                <TextBlock x:Name="DischargingHint" Grid.Row="1" Text="Внимание! Изменения могут не сохраниться" 
                           FontSize="16" Foreground="#F0B3BA" TextWrapping="Wrap" Margin="0,-10,0,0" Opacity="0">
                    <TextBlock.Style>
                        <Style>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=DeleteButton}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>

                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>

