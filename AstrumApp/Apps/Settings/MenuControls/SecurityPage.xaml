<UserControl x:Class="AstrumApp.Apps.Settings.MenuControls.SecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:astrum="clr-namespace:AstrumApp"
             xmlns:local="clr-namespace:AstrumApp.Apps.Settings.MenuControls"
             xmlns:controls="clr-namespace:AstrumApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="Security" ObjectInstance="{x:Static astrum:App.Security}"/>
    </UserControl.Resources>

    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <WrapPanel Margin="20">
            <WrapPanel.Resources>
                <Style TargetType="controls:SecurityCard">
                    <Setter Property="Margin" Value="0,0,30,0"/>
                </Style>
            </WrapPanel.Resources>
            <controls:SecurityCard Title="Пароль" Icon="\Assets\icons\settings\password.png" AccentColor="#8B7BFF">
                <controls:SecurityCard.CardContent>
                    <TextBlock Text="Надежный пароль" FontSize="18" Foreground="White"/>
                </controls:SecurityCard.CardContent>
            </controls:SecurityCard>

            <controls:SecurityCard Title="Устройства" Icon="\Assets\icons\settings\password.png" AccentColor="#3DD7C8" Width="220">
                <controls:SecurityCard.CardContent>
                    <TextBlock Text="Desktop..." FontSize="18" Foreground="White"/>
                </controls:SecurityCard.CardContent>
            </controls:SecurityCard>

            <controls:SecurityCard Title="PIN" Icon="\Assets\icons\settings\password.png" AccentColor="#58D68D" 
                                   NavPage="PinSettingsPage" NavButton="Настроить PIN">
                <controls:SecurityCard.CardContent>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Статус" FontSize="14" Foreground="#A0A0A0"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Ellipse Width="8" Height="8" Fill="{Binding Pin.PinStatusBrush, Source={StaticResource Security}}" Margin="0,0,8,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{Binding Pin.PinStatusBrush, Source={StaticResource Security}}" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <TextBlock Text="{Binding Pin.PinStatusText , Source={StaticResource Security}}" FontSize="16" Foreground="White"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Text="Последнее изменение" FontSize="14" Foreground="#A0A0A0"/>

                        <TextBlock Text="{Binding Pin.LastChangedText, Source={StaticResource Security}}" FontSize="16" Foreground="White"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </controls:SecurityCard.CardContent>
            </controls:SecurityCard>
        </WrapPanel>
    </Grid>
</UserControl>
