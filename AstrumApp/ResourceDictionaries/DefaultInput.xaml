<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="InputBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#10171F"/>
        <Setter Property="BorderBrush" Value="#2B3C4D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="MinHeight" Value="42"/>
    </Style>

    <Style x:Key="InputGlowStyle" TargetType="Border">
        <Setter Property="Height" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="CornerRadius" Value="14,14,0,0"/>
        <Setter Property="Opacity" Value="0.06"/>
    </Style>

</ResourceDictionary>