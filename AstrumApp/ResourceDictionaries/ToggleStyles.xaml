<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AstrumApp.Services">

    <local:HalfValueConverter x:Key="HalfConverter"/>
    <local:OffsetConverter x:Key="OffsetConverter"/>

    <Style x:Key="SwitchBox" TargetType="ToggleButton">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="#FF141B22"/>
        <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
        <Setter Property="Foreground" Value="#FF808080"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="SwitchBackground" Background="{TemplateBinding Background}"
                            CornerRadius="{Binding Height, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HalfConverter}}"/>
                        <Border x:Name="SwitchThumb" Background="{TemplateBinding Foreground}" 
                                Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Height}"
                                Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Height}"
                                CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Height}"
                                HorizontalAlignment="Left">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThumbTransform" X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>