<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DefaultPasswordBox" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CaretBrush" Value="#6FB6FF"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="5, 0, 0, 1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="1">
                            <Border x:Name="Border" Style="{StaticResource InputBorderStyle}">
                                <Border.BorderBrush>
                                    <SolidColorBrush x:Name="BorderBrushColor" Color="#2B3C4D"/>
                                </Border.BorderBrush>
                            </Border>
                            
                            <Border Style="{StaticResource InputGlowStyle}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="White" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="BorderBrushColor" Storyboard.TargetProperty="Color" 
                                                To="#3F5670" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="BorderBrushColor" Storyboard.TargetProperty="Color" 
                                                To="#2B3C4D" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#506B88"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox" x:Key="PasswordBoxStyleSecurity">
        <Setter Property="Background" Value="#18000000"/>
        <Setter Property="BorderBrush" Value="#45FFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Width" Value="160"/>
        <Setter Property="Height" Value="35"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{TemplateBinding Tag}" FontSize="14" FontWeight="SemiBold" Foreground="#9FB3C8" 
                                    Margin="2,0,0,0" Grid.Row="0" x:Name="TagTextBlock"/>

                        <Grid Grid.Row="1">
                            <Border x:Name="NormalBorder" Background="#18000000" BorderBrush="#45FFFFFF"
                                     Padding="{TemplateBinding Padding}" CornerRadius="10" BorderThickness="1"/>

                            <Border x:Name="ActiveBorder" Background="#24FFFFFF" BorderBrush="#70FFFFFF"
                                     Padding="{TemplateBinding Padding}" CornerRadius="10" BorderThickness="1" Opacity="0"/>


                            <ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" 
                                               VerticalScrollBarVisibility="Hidden"/>

                            <Button x:Name="ShowPasswordButton" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,5,0"
                                 Content="👁" Background="Transparent" BorderThickness="0" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>


                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard Name="HoverInAnimation">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveBorder" Storyboard.TargetProperty="Opacity"
                                                          To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard Name="HoverOutAnimation">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveBorder" Storyboard.TargetProperty="Opacity"
                                                          To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Trigger.EnterActions>
                                <StopStoryboard BeginStoryboardName="HoverInAnimation"/>
                                <StopStoryboard BeginStoryboardName="HoverOutAnimation"/>

                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="NormalBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                         To="#4A8DFF" Duration="0:0:0.1"/>
                                        <ColorAnimation Storyboard.TargetName="NormalBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                         To="#30FFFFFF" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveBorder" Storyboard.TargetProperty="Opacity"
                                                          To="0" Duration="0:0:0.1"/>

                                        <ColorAnimation Storyboard.TargetName="NormalBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                         To="#45FFFFFF" Duration="0:0:0.1"/>
                                        <ColorAnimation Storyboard.TargetName="NormalBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                         To="#18000000" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>

                            <!--<Setter TargetName="NormalBorder" Property="BorderBrush" Value="#4A8DFF"/>
                             <Setter TargetName="NormalBorder" Property="Background" Value="#30FFFFFF"/>-->

                            <Setter TargetName="ActiveBorder" Property="Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>